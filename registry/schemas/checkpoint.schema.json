  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "checkpoint_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[0-9]+)?$",
      "title": "Checkpoint Id",
      "type": "string"
    },
    "model_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Model Id",
      "type": "string"
    },
    "checkpoint_name": {
      "minLength": 1,
      "title": "Checkpoint Name",
      "type": "string"
    },
    "modalities": {
      "items": {
        "enum": [
          "CFP",
          "OCT",
          "OCTA",
          "FFA",
          "SLO",
          "ICGA",
          "FAF",
          "ultrasound",
          "external_eye",
          "slit_lamp",
          "specular_microscopy",
          "MRI",
          "UBM",
          "CT",
          "RetCam",
          "PET",
          "X_ray",
          "text",
          "retinal_layer_pseudolabels",
          "other"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Modalities",
      "type": "array"
    },
    "weight_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Weight Url"
    },
    "provider": {
      "enum": [
        "huggingface",
        "google_drive",
        "github_release",
        "zenodo",
        "official_repository",
        "other",
        "unknown"
