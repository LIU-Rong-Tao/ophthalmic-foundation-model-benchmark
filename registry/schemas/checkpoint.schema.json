    "access_type": {
      "enum": [
        "open",
        "auth_required",
        "gated",
        "application_required",
        "api_only",
        "unavailable",
        "unknown"
      ],
      "title": "Access Type",
      "type": "string"
    },
    "requires_auth": {
      "title": "Requires Auth",
      "type": "boolean"
    },
    "redistribution_allowed": {
      "enum": [
        "yes",
        "no",
        "unknown"
      ],
      "title": "Redistribution Allowed",
      "type": "string"
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "License"
    },
    "framework": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Framework"
    },
    "input_size": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Input Size"
