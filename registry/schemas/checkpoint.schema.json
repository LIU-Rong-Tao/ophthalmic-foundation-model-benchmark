    "model_id",
    "checkpoint_name",
    "modalities",
    "weight_url",
    "provider",
    "access_type",
    "requires_auth",
    "redistribution_allowed",
    "license",
    "framework",
    "input_size",
    "normalization",
    "embedding_dim",
    "sha256",
    "source_commit",
    "verification_status",
    "last_verified",
    "provenance",
