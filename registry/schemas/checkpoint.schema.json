    "sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Sha256"
    },
    "source_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Commit"
    },
    "verification_status": {
      "enum": [
        "seed_unverified",
        "partially_verified",
        "verified",
        "blocked"
