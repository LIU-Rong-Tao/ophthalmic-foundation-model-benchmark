        "normalization": {
          "anyOf": [
            {
              "$ref": "#/$defs/NormalizationSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "title": "PreprocessingSpec",
      "type": "object"
